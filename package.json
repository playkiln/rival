{
  "name": "rival",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "esbuild scripts/recording.test.ts --bundle --platform=node --outfile=node_modules/.cache/rival-tests/recording.test.cjs --log-level=warning && node node_modules/.cache/rival-tests/recording.test.cjs",
    "ghosts": "esbuild scripts/record-ghosts.ts --bundle --platform=node --outfile=node_modules/.cache/rival-tests/record-ghosts.cjs --log-level=warning && node node_modules/.cache/rival-tests/record-ghosts.cjs",
    "simcheck": "esbuild scripts/simcheck.ts --bundle --platform=node --outfile=node_modules/.cache/rival-tests/simcheck.cjs --log-level=warning && node node_modules/.cache/rival-tests/simcheck.cjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^6.3.5"
  }
}
